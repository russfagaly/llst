# Database Configuration (Supabase)
# Get this from Supabase project settings > Database > Connection string
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your_password@db.xxxxx.supabase.co:5432/postgres

# File Upload Directory
UPLOAD_DIR=./uploads

# JWT Secret Key (generate a strong random key for production)
# You can generate one with: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-this-in-production-use-openssl-rand-hex-32

# Initial Setup Secret (for creating first superuser)
# Change this immediately after creating your superuser
INIT_SECRET=change-this-secret-for-creating-first-admin

# Optional: For production deployment
# PORT=8000
